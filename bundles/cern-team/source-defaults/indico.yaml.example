# OPTIONAL — Indico connector (cache-backed). Not active: the
# installer only picks up `*.yaml` files from source-defaults/, and a
# fully commented .yaml would still scaffold an EMPTY registry entry
# (the installer maps every file to a source id), so the optional
# entry ships as .example instead.
#
# To enable on an instance: rename to indico.yaml BEFORE install (or
# paste the block into the instance's source_registry.yaml after
# install, replacing ${...} by hand). Requires the meeting_minutes /
# document subtypes (in the copied operations.yaml slice) AND the
# `meeting_minutes_contains_document` narrowing from the wheel's
# bridges/operations.yaml — NOTE: the install runbook's pruned bridge
# copy does NOT include it (the default prune keeps only
# cmssw_release_supersedes_release). When enabling this connector,
# also copy that narrowing into the instance's
# schemas/bridges/operations.yaml, or the catalog composes green and
# the first ingest of an event with attachments fails at ingest time
# (ProducerPolicyViolation — narrowings outside schemas/bridges/ are
# silently ignored, okg#1282).
indico:
  module: archi.sources.indico
  class: IndicoAdapter
  ownership_id: ${deployment_name}.indico
  admission_policy:
    producer_id: ${deployment_name}.indico
    producer_kind: source
    trust_label: implicit_legacy_trusted
    admission_mode: fast_track
    authority_scope:
      source_family: cern-team
      source_name: indico
    output_signature:
      nodes:
        - {subtype: meeting_minutes}
        - {subtype: document}
        - {subtype: document_chunk}
      edges:
        - {src_subtype: meeting_minutes, edge_type: contains, dst_subtype: document}
        - {src_subtype: document, edge_type: contains, dst_subtype: document_chunk}
        - {src_subtype: document_chunk, edge_type: member_of, dst_subtype: document}
    output_scope_summary:
      summary: Indico meetings with parsed PDF attachment documents and chunks
      nodes: [meeting_minutes, document, document_chunk]
      edges:
        - meeting_minutes contains document
        - document contains document_chunk
        - document_chunk member_of document
  # discovery_crawl is what this reader does: it walks a scope (the local
  # records cache) in full every run and diffs it by content hash, and an
  # event absent from a completed scope is retracted. The profile matrix
  # allows only `scoped_locator` identity with it, and that is honest here —
  # a meeting is located at `event/<id>` inside the instance named by
  # `base_url`, which is what the reader emits as `source_record_id`.
  # It is NOT `remote_id`/`mutable_api`: nothing queries an API and there is
  # no cursor.
  #
  # One limit worth knowing: an attachment's locator is POSITIONAL —
  # `event/<id>/pdf/<n>.pdf`, where n is its index in the cached event. If a
  # meeting's attachments are re-ordered upstream, the same documents come
  # back under different record keys, which reads as a retraction plus an
  # insert rather than a move. The cache carries no stable per-attachment id
  # to key on instead. Unchanged behaviour; recorded here so it is not a
  # surprise.
  source_class: discovery_crawl
  record_identity_kind: scoped_locator
  record_identity_fields: [path]
  source_revision_kind: content_hash
  deletion_semantics: missing_from_completed_scope
  publication_mode: published_generation
  required_for_baseline: false
  params:
    records_path: ${archi_data_root}/indico/records.json
    base_url: https://indico.cern.ch
  sync:
    triggers: [manual, reconcile]
    default_event_mode: scope_complete
    reconcile_mode: scope_complete
