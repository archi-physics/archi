# OPTIONAL — CMSSW release catalog pinned to reviewed, immutable bytes
# instead of the live cms-bot fetch. Not loaded by default.
#
# ENABLING THIS REPLACES cmssw_releases.yaml; IT DOES NOT ADD TO IT.
# Both files declare the same source id (`cmssw_releases:`), and the
# installer merges source-defaults by that id — so if you leave the live
# file in place, one of the two silently wins and the other is discarded
# with no warning. Delete (or move aside) cmssw_releases.yaml when you
# rename this file to cmssw_releases_frozen.yaml.
#
# Supply the two inputs as install answers — no hand-editing of this file:
#
#   okg install --profile cern-team --deployment-name <slug> \
#     --postgres-dsn "$OKG_DSN" \
#     --cmssw-map-path /reviewed/path/releases.map \
#     --cmssw-map-digest "sha256:$(shasum -a 256 /reviewed/path/releases.map | cut -d' ' -f1)"
#
# Both default to empty. That is deliberate and safe: an empty digest is
# not "unpinned" — the reader rejects it with `map_cache_digest must be
# sha256:<64 lowercase hex>` rather than falling back to reading unverified
# bytes. Leaving the digest off is a loud failure, never a silent one.
cmssw_releases:
  module: archi.sources.cmssw
  class: CMSSWReleaseAdapter
  ownership_id: ${deployment_name}.cmssw-releases
  admission_policy:
    producer_id: ${deployment_name}.cmssw-releases
    producer_kind: source
    trust_label: implicit_legacy_trusted
    admission_mode: fast_track
    authority_scope:
      source_family: cern-team
      source_name: cmssw_releases
    output_signature:
      nodes:
        - {subtype: cmssw_release}
      edges:
        - {src_subtype: cmssw_release, edge_type: supersedes, dst_subtype: cmssw_release}
    output_scope_summary:
      summary: CMSSW releases, release families, and supersedes chains
      nodes: [cmssw_release]
      edges:
        - cmssw_release supersedes cmssw_release
  source_class: reference_catalog
  # NOTE: the substrate's reference_catalog profile only admits
  # `domain_key` (deployment lint blocker
  # deployment.source_registry.profile_invalid otherwise); the
  # cmssw.py docstring template and the w1-scratch proven registry
  # both use it.
  record_identity_kind: domain_key
  record_identity_fields: [release]
  source_revision_kind: content_hash
  deletion_semantics: missing_from_completed_scope
  publication_mode: published_generation
  required_for_baseline: true
  params:
    # Reviewed immutable bytes and their independently verified raw SHA256.
    # SINGLE-quoted, and that matters. Install answers are substituted into
    # this file as TEXT and the result is then parsed as YAML, so the quoting
    # style decides how the answer is read. In a double-quoted scalar YAML
    # would apply backslash escapes: `C:\reviewed\releases.map` would become
    # `C:` + a carriage return + `eviewed...`, and the only symptom would be a
    # puzzling cache_missing. Single quotes take backslashes literally.
    # (Trade-off: an answer containing an apostrophe breaks the parse. That is
    # a loud YAML error naming this file, which beats a silently wrong path.)
    # The quotes also keep an unanswered question as "" rather than a null.
    map_cache_path: '${cmssw_map_path}'
    map_cache_digest: '${cmssw_map_digest}'
    fetch: false
  sync:
    triggers: [manual, reconcile]
    default_event_mode: scope_complete
    reconcile_mode: scope_complete
