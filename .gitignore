# Playbook integration + UI tests — kept LOCAL-ONLY (need a Postgres on :5439 /
# Playwright; excluded from the PR so CI stays unit-only). Run locally with:
#   pytest tests/smoke/test_playbooks_integration.py -m integration
#   BASE_URL=http://localhost:7870 npx playwright test tests/ui/playbooks.spec.ts
tests/smoke/test_playbooks_integration.py
tests/ui/playbooks.spec.ts
.claude/
.okg/
python/dist/
profiles/

# PACT generated artifacts: pact/project.yaml declares pact.md and
# pact.yaml.lock local/noncanonical, and CLAUDE.md says they should not be
# committed. The CLI regenerates them per checkout; committing them made five
# stale copies that disagreed with each other.
pact/**/pact.yaml.lock
pact/**/pact.md
pact/.locks/

# Cache snapshots are private okg-deployments release assets; see
# docs/cache-snapshot.md. Never commit them here (this repository is public).
*.tar.zst
snapshot.lock.yaml
cms-cache-*/
